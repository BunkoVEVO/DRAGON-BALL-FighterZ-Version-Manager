<Window x:Class="DBFZVersionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBFZ Version Manager"
        Height="500"
        Width="800"
        MinHeight="400"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#171717">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="DBFZ Version Manager"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Download and install historical game versions"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Border Grid.Row="1"
                Background="#242424"
                CornerRadius="8"
                Padding="20">

            <StackPanel>
                <TextBlock Text="Game Version"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <ComboBox x:Name="VersionSelector"
                          Height="35"
                          FontSize="14"
                          SelectedIndex="-1">
                    <ComboBoxItem Content="Select a version..."/>
                </ComboBox>

                <Button x:Name="InstallButton"
                        Content="Download and Install Selected Version"
                        Height="40"
                        Margin="0,20,0,10"
                        FontSize="14"/>

                <TextBlock Text="Download Status"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,30,0,10"/>

                <ProgressBar x:Name="DownloadProgress"
                             Height="15"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>

                <TextBlock x:Name="StatusText"
                           Text="Waiting for a download..."
                           Foreground="Gray"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="DBFZ Version Manager 1.0"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>
